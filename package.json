{
  "name": "full-stack-ecommerce",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:backend": "node ./scripts/run-app.mjs backend",
    "dev:web-client": "node ./scripts/run-app.mjs web-client",
    "dev:web-admin": "node ./scripts/run-app.mjs web-admin",
    "lint": "turbo run lint",
    "lint:backend": "pnpm --filter @repo/backend lint",
    "lint:web-client": "pnpm --filter @repo/web-client lint",
    "lint:web-admin": "pnpm --filter @repo/web-admin lint",
    "test": "turbo run test",
    "test:backend": "pnpm --filter @repo/backend test",
    "test:web-client": "pnpm --filter @repo/web-client test",
    "test:web-admin": "pnpm --filter @repo/web-admin test",
    "typecheck": "turbo run typecheck",
    "typecheck:backend": "pnpm --filter @repo/backend typecheck",
    "typecheck:web-client": "pnpm --filter @repo/web-client typecheck",
    "typecheck:web-admin": "pnpm --filter @repo/web-admin typecheck",
    "clean": "turbo run clean",
    "dev:docker": "docker compose -f docker-compose.dev.yml up",
    "dev:docker:build": "docker compose -f docker-compose.dev.yml up --build",
    "dev:docker:down": "docker compose -f docker-compose.dev.yml down",
    "dev:docker:migrate": "docker compose -f docker-compose.dev.yml exec backend pnpm --filter @repo/backend exec prisma migrate deploy",
    "dev:docker:generate": "docker compose -f docker-compose.dev.yml exec backend pnpm --filter @repo/backend db:generate",
    "dev:docker:seed": "docker compose -f docker-compose.dev.yml exec backend pnpm --filter @repo/backend db:seed",
    "dev:docker:studio": "docker compose -f docker-compose.dev.yml exec backend sh -lc 'pnpm --filter @repo/backend exec prisma studio --url \"$DATABASE_URL\" --port 5555 --browser none'",
    "prod:docker": "docker compose up"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@next/eslint-plugin-next": "^15.5.15",
    "@types/node": "^24.8.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.38.0",
    "tsup": "^8.5.1",
    "turbo": "^2.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  }
}
